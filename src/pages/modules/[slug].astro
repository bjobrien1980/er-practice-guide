---
import { getCollection, render } from "astro:content";
import ModuleLayout from "../../layouts/ModuleLayout.astro";

export async function getStaticPaths() {
  const modules = await getCollection("modules");
  return modules.map((m) => ({
    params: { slug: m.data.slug },
    props: { entry: m },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { id, title, tier, provisions, version, last_updated, law_current_as_at, law_sources, reading_minutes, related } = entry.data;
---

<ModuleLayout
  id={id}
  title={title}
  tier={tier}
  provisions={provisions}
  version={version}
  last_updated={last_updated}
  law_current_as_at={law_current_as_at}
  law_sources={law_sources}
  reading_minutes={reading_minutes}
  related={related}
  headings={headings}
>
  <Content />
</ModuleLayout>
