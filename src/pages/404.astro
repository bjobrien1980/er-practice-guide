---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="That page is not part of the ER Practice Guide.">
  <main id="top" class="standalone">
    <p class="eyebrow">Page not found</p>
    <h1>That page isn't in the guide</h1>
    <p class="lead">The link may be out of date, or the address may have been mistyped. Modules are sometimes renumbered or renamed.</p>
    <div class="link-grid">
      <a href="/#modules"><b>All modules</b><small>Browse the full list by tier.</small></a>
      <a href="/start-here"><b>Start here</b><small>Frame a matter before choosing a legal pathway.</small></a>
      <a href="/glossary"><b>Glossary</b><small>Plain-language definitions of recurring terms.</small></a>
    </div>
    <p>You can also use the search box at the top of the page.</p>
  </main>
</BaseLayout>
