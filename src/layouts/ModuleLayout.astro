---
import BaseLayout from "./BaseLayout.astro";
import { getTiers } from "../data/nav";
import { linkGlossaryTerms } from "../lib/glossary-links";
import { linkModuleReferences } from "../lib/module-links";

interface Props {
  id: number;
  title: string;
  tier: number;
  provisions: string[];
  version: string;
  last_updated: string;
  law_current_as_at: string | null;
  law_sources: string[];
  reading_minutes: number;
  related: number[];
  headings: { depth: number; slug: string; text: string }[];
}

const { id, title, tier, provisions, version, last_updated, law_current_as_at, law_sources, reading_minutes, related, headings } =
  Astro.props as Props;

const TIERS = await getTiers();
const tierInfo = TIERS[tier - 1];
const allModules = TIERS.flatMap((t) => t.modules);
const position = allModules.findIndex((m) => m.id === id);
const prev = position > 0 ? allModules[position - 1] : undefined;
const next = position >= 0 ? allModules[position + 1] : undefined;
const relatedModules = related
  .map((rid) => allModules.find((m) => m.id === rid))
  .filter((m) => m !== undefined);
const sections = headings.filter((h) => h.depth === 2);

// Show the calendar date as written in the source timestamp, without shifting time zones.
const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
function dateLabel(value: string) {
  const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(value);
  return m ? `${Number(m[3])} ${MONTHS[Number(m[2]) - 1]} ${m[1]}` : value;
}
const updatedLabel = dateLabel(last_updated);

// Glossary terms are linked on first use in the module body.
const body = linkModuleReferences(linkGlossaryTerms(await Astro.slots.render("default")), allModules);
---

<BaseLayout title={title}>
  <div class="shell">
    <nav class="modules" aria-label="Modules">
      {TIERS.map((t) => (
        <>
          <p class="nav-heading">{t.title}</p>
          <ol>
            {t.modules.map((m) => (
              <li class={m.id === id ? "current" : undefined}>
                <a href={`/modules/${m.slug}`} aria-current={m.id === id ? "page" : undefined}>
                  <span class="n">{m.id}</span>
                  <span>{m.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </>
      ))}
    </nav>

    <article id="top" data-pagefind-body>
      <p class="crumbs"><a href="/#modules">All modules</a> · {tierInfo?.title} · Module {id}</p>
      <h1>{title}</h1>

      <div class="meta">
        <span class="provisions"><b>Provision{provisions.length > 1 ? "s" : ""}</b> {provisions.map((p) => <span class="statute">{p}</span>)}</span>
        <span><b>Version</b> <span class="pill">{version}</span></span>
        <span><b>Last updated</b> <time datetime={last_updated}>{updatedLabel}</time></span>
        <span><b>Reading time</b> {reading_minutes} min</span>
        {/* Shown only once a currency check has been recorded in the module's front matter. */}
        {law_current_as_at && (
          <span class="currency">
            <b>Law checked</b>{" "}
            <time datetime={law_current_as_at}>{dateLabel(law_current_as_at)}</time>
            {law_sources.length > 0 && <> against {law_sources.join("; ")}</>}
          </span>
        )}
      </div>

      <div class="notice info">
        <b>Training material only — not legal advice.</b> The law and Commission procedure change, so check the current source before you rely on anything here. <a href="/about#checking">How this guide is checked</a>.
      </div>

      {sections.length > 0 && (
        <details class="toc-inline">
          <summary>On this page</summary>
          <ol>
            {sections.map((h) => (
              <li><a href={`#${h.slug}`}>{h.text}</a></li>
            ))}
          </ol>
        </details>
      )}

      <Fragment set:html={body} />

      <nav class="pagefoot" aria-label="Previous and next module">
        {prev ? (
          <a href={`/modules/${prev.slug}`} rel="prev"><small>Previous</small>{prev.id}. {prev.title}</a>
        ) : <span />}
        {next ? (
          <a class="next" href={`/modules/${next.slug}`} rel="next"><small>Next</small>{next.id}. {next.title}</a>
        ) : <span />}
      </nav>
    </article>

    <aside class="rail" aria-label="On this page">
      <p class="nav-heading">On this page</p>
      <ol id="toc">
        {sections.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
      {relatedModules.length > 0 && (
        <div class="rel">
          <p class="nav-heading">Related modules — overlaps and next places to look</p>
          <ol>
            {relatedModules.map((m) => (
              <li><a href={`/modules/${m.slug}`}>{m.id}. {m.title}</a></li>
            ))}
          </ol>
        </div>
      )}
    </aside>
  </div>

  <script>
    // Highlight the section currently being read in the "On this page" rail.
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("#toc a"));
    const heads = links
      .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
      .filter((h): h is HTMLElement => h !== null);
    function spy() {
      let cur = heads[0];
      heads.forEach((h) => {
        if (h.getBoundingClientRect().top < 120) cur = h;
      });
      links.forEach((a) => {
        if (cur && decodeURIComponent(a.hash.slice(1)) === cur.id) a.setAttribute("aria-current", "location");
        else a.removeAttribute("aria-current");
      });
    }
    if (heads.length) {
      window.addEventListener("scroll", spy, { passive: true });
      spy();
    }
  </script>
</BaseLayout>
