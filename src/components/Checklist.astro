---
interface Item {
  group: string;
  text: string;
}
interface Props {
  title: string;
  items: Item[];
  /** What to do while items are open. Follows "N items open." */
  openAdvice?: string;
  /** What a fully ticked list means. Follows "All items ticked." */
  readyAdvice?: string;
}
const {
  title,
  items,
  openAdvice = "Work through the open items, or escalate them to a senior ER adviser, before going further.",
  readyAdvice = "This looks ready for senior ER review.",
} = Astro.props as Props;
const uid = `checklist-${Math.random().toString(36).slice(2, 9)}`;
let lastGroup = "";
---

<div class="tool" id={uid} data-title={title} data-open-advice={openAdvice} data-ready-advice={readyAdvice}>
  <div class="progress"><span class="count">0 of {items.length}</span><div class="bar" aria-hidden="true"><i class="fill"></i></div></div>
  <ul class="checks">
    {items.map((it, i) => {
      const showGroup = it.group !== lastGroup;
      lastGroup = it.group;
      return (
        <>
          {showGroup && <li class="group">{it.group}</li>}
          <li>
            <label for={`${uid}-c${i}`}>
              <input type="checkbox" id={`${uid}-c${i}`} data-text={it.text} />
              <span>{it.text}</span>
            </label>
          </li>
        </>
      );
    })}
  </ul>
  <div class="status open" role="status"></div>
  <div class="row">
    <button type="button" class="primary copy-btn">Copy checklist as text</button>
    <button type="button" class="reset-btn">Clear all</button>
  </div>
  <p class="saved-note">Ticks are saved in this browser only.</p>
</div>

<script>
  function initChecklist(root: HTMLElement) {
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>(".checks input"));
    const countEl = root.querySelector(".count")!;
    const fillEl = root.querySelector<HTMLElement>(".fill")!;
    const statusEl = root.querySelector<HTMLElement>(".status")!;
    const title = root.dataset.title || "Checklist";

    function update() {
      const n = boxes.filter((b) => b.checked).length;
      countEl.textContent = `${n} of ${boxes.length}`;
      fillEl.style.width = `${(100 * n) / boxes.length}%`;
      const open = boxes.length - n;
      const lead = document.createElement("strong");
      lead.textContent = open === 0 ? "All items ticked." : `${open} item${open === 1 ? "" : "s"} open.`;
      const advice = open === 0 ? root.dataset.readyAdvice : root.dataset.openAdvice;
      statusEl.className = open === 0 ? "status ready" : "status open";
      statusEl.replaceChildren(lead, ` ${advice ?? ""}`);
    }

    // Ticks are remembered in this browser, keyed by page and checklist title.
    const storeKey = `erpg:checklist:${location.pathname.replace(/\/$/, "")}:${title}`;
    function save() {
      try {
        const ticked = boxes.filter((b) => b.checked).map((b) => b.dataset.text);
        if (ticked.length) localStorage.setItem(storeKey, JSON.stringify(ticked));
        else localStorage.removeItem(storeKey);
      } catch {
        // Storage unavailable (private window, blocked site data): the checklist still works.
      }
    }
    try {
      // Saved by item text, so editing or reordering the checklist never ticks the wrong item.
      const ticked = new Set<string>(JSON.parse(localStorage.getItem(storeKey) ?? "[]"));
      boxes.forEach((b) => (b.checked = ticked.has(b.dataset.text ?? "")));
    } catch {
      // Nothing saved, or storage unavailable.
    }

    boxes.forEach((b) =>
      b.addEventListener("change", () => {
        update();
        save();
      })
    );
    update();

    root.querySelector(".reset-btn")?.addEventListener("click", () => {
      boxes.forEach((b) => (b.checked = false));
      update();
      save();
    });

    root.querySelector(".copy-btn")?.addEventListener("click", (e) => {
      const lines = [title, ...boxes.map((b) => `${b.checked ? "[x]" : "[ ]"} ${b.dataset.text}`)];
      const btn = e.currentTarget as HTMLButtonElement;
      navigator.clipboard
        .writeText(lines.join("\n"))
        .then(() => {
          btn.textContent = "Copied";
          setTimeout(() => (btn.textContent = "Copy checklist as text"), 1600);
        })
        .catch(() => {
          btn.textContent = "Copy not allowed here";
        });
    });
  }

  document.querySelectorAll<HTMLElement>(".tool[data-title]").forEach(initChecklist);
</script>
