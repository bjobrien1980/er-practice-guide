---
import citationsData from "../../data/citations.json";

interface Props {
  id: string;
  at: string;
  phrase?: string;
  status?: "flagged";
  /** Show the quoted phrase inline before the reference. Use when the sentence relies on the quotation. */
  quote?: boolean;
}

const { id, at, status, phrase, quote } = Astro.props as Props;
const showQuote = Boolean(quote && phrase);

const registry = citationsData.citations as Record<string, { url: string | null; short_name: string }>;

const entry = registry[id];
if (!entry) {
  throw new Error(
    `<Cite id="${id}"> has no entry in data/citations.json — run scripts/build_citation_registry.py ` +
      `after adding a verified entry to data/citation_facts.json.`
  );
}

const label = `${id} at ${at}`;
const isFlagged = status === "flagged";
---

{showQuote && <span class="cite-quote">“{phrase}”</span>}{showQuote && " "}{entry.url && !isFlagged ? (
  <a class="cite" href={entry.url} target="_blank" rel="noopener noreferrer" title={entry.short_name}>{label}</a>
) : isFlagged ? (
  <span class="cite flagged" title="Unverified pinpoint — flagged for checking">{label} (unverified)</span>
) : (
  <span class="cite unlinked" title={`${entry.short_name} — no public URL on record`}>{label}</span>
)}
