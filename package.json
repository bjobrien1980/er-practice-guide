{
  "name": "er-practice-guide",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run registry && astro dev",
    "registry": "python3 scripts/build_citation_registry.py",
    "verify": "python3 scripts/verify_pinpoints.py",
    "linkcheck": "python3 scripts/link_check.py",
    "contentcheck": "python3 scripts/rendered_content_check.py",
    "prebuild": "npm run registry && npm run verify && npm run linkcheck",
    "build": "astro build",
    "postbuild": "python3 scripts/build_section_index.py && pagefind --site dist && npm run contentcheck",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.9",
    "@astrojs/mdx": "^8.1.5",
    "astro": "7.4.1"
  },
  "devDependencies": {
    "pagefind": "1.6.0"
  }
}
